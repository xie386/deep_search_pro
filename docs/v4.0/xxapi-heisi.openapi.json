{
 "openapi": "3.0.0",
 "info": {
  "title": "小小API · 黑丝图片",
  "version": "1"
 },
 "servers": [
  {
   "url": "https://v2.xxapi.cn"
  }
 ],
 "paths": {
  "/api/heisi": {
   "get": {
    "operationId": "heisiImage",
    "summary": "随机返回一张黑丝图片地址",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "code": {
           "type": "integer"
          },
          "msg": {
           "type": "string"
          },
          "data": {
           "type": "string",
           "description": "图片地址（http/https）"
          }
         }
        }
       }
      }
     }
    },
    "description": "返回 JSON，data 字段是图片地址。若传 return=302 会 302 跳到 CDN（跨主机，本项目安全策略不跟随），所以不要传。"
   }
  }
 }
}