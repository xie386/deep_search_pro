# ============ 大模型配置（必填） ============
# 使用 OpenAI 兼容接口接入模型
# ★★ 默认模型**必须是有多模态（视觉）能力的模型** —— 两点原因（2026-10-14 用户定稿）：
#    ① 浏览器抓取工具在 JS 动态浮层上要靠"看截图"才能取到字段（纯文本读 DOM 会反复超时，
#       实测同一题：纯文本 12 分钟拿不到上下文与价格；多模态 4 步 51.6 秒一次拿全）；
#    ② 本项同时是浏览器侧的**兜底模型**：账号没配「定制助手 · 模型选型」时，浏览器侧就用它
#       （前端设置页「🌐 浏览器抓取 → 浏览器侧模型」留空即跟随聊天侧）。
#    示例：gpt-4o / qwen-vl-max / claude-3-5-sonnet 等；不要用纯文本模型（如 deepseek-chat）。
LLM_MODEL_MAX=你的模型名称，例如 gpt-4o / qwen-vl-max / claude-sonnet
OPENAI_API_KEY=你的API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1

# ============ 网络搜索（用到网络搜索助手时填写） ============
TAVILY_API_KEY=你的Tavily密钥

# ============ 数据库（用到数据库查询助手时填写） ============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=你的数据库用户名
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=你的数据库名
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ============ RAGFlow 知识库（用到 RAGFlow 助手时填写） ============
# ── 未使用（可删）：RAGFlow 接入未落地，代码里零引用，保留仅为历史对照 ──
# RAGFLOW_API_KEY=你的RAGFlow密钥
# RAGFLOW_BASE_URL=https://your-ragflow-host

# ============ 向量模型、重排模型路径配置（用知识库/RAG 时必填） ============
# 填**本机**实际的模型目录（示例是占位，照抄跑不起来 ✓）
EMBEDDING_MODEL_PATH=D:/path/to/your/bge-large-zh
RERANKER_MODEL_PATH=D:/path/to/your/bge-reranker-base
# 设备：默认 cpu（没显卡也能跑）；有 NVIDIA 卡且装了 CUDA 版 torch 才改 cuda
EMBEDDING_DEVICE=cpu

# ============ 个人库 SQLite 路径（可选，默认 data/personal.db） ============
# PERSONAL_DB_PATH=data/personal.db

# ============ 语音转文字（长按输入框里的话筒说话 → 松手转文字，v3.1 多媒体） ============
# 默认就是下面这样 ✓ 不写也能用（这一节是给需要改的人看的 ✓）
ASR_ENABLED=1
ASR_LANG=zh
# ★ 由 ASR 引擎侧读取（本项目 Python 代码不直接用）；换模型时同步改这里
ASR_MODEL_DIR=D:/path/to/your/asr-model
# ASR_PORT=8126      # 常驻识别引擎的本地端口（被占用时改 ✓ 改完重启后端 ✓）
# ASR_IDLE=600       # 引擎空闲多少秒后自动退出（下次用到会自动拉起 ✓ 不白占内存 ✓）
# ASR_SERVE_BIN=     # `asr` 可执行文件路径（一般不用填 ✓ 默认自动探测 ✓）

# ============ MySQL 纯 Python 模式（可选，默认 True） ============
# MYSQL_USE_PURE=True
# 工作台天气卡默认城市（Open-Meteo 免 Key 数据源）
WEATHER_CITY=成都

# ============ 邮件发信（验证码通道：绑定邮箱 / 注销账号） ============
# 项目级只配一个发件箱：
#   QQMAIL = 发件邮箱地址
#   QQMSTP = 该邮箱的 SMTP 授权码（★ 不是邮箱登录密码：QQ 邮箱 → 设置 → 账号 → 开启 SMTP 服务后生成）
# 口径：这两个键**只放在 .env** —— 不进前端、不进数据库、接口不回传、日志不回显。
#       换发件箱 = 只改这两行；每个账号绑自己的收件邮箱（账号级，与发件箱无关）。
QQMAIL=
QQMSTP=
# 发件人显示名（收件人看到的名字；可在设置页改）
# SMTP_FROM_NAME=智选情报官
# 换非 QQ 服务商时才需要填这三项（不填 = smtp.qq.com:465 + SSL）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SSL=1
# MAIL_DEBUG=0            # 1 = 不发信（验证码写 tests/test_out/_mail_outbox.log），本机联调用
# 发信配额（也可在设置页改；0 = 不限）
# MAIL_QUOTA_PER_ACCOUNT_DAY=10
# MAIL_QUOTA_GLOBAL_DAY=50

# ============ 仅开发 / 脚本用（不影响运行时；不填也能跑） ============
# 这些键只被开发脚本读取，别再当成"运行必需"：
# APP_URL / APP_PWD   → scripts/cdp_*.py 连本机服务做真机探针用（APP_PWD = 测试账号密码）
# CDP_PORT            → 上述 CDP 探针的调试端口（默认 9333）
# OPENROUTER_API_KEY  → 调研期 demo（research/02-Jev仲裁层-demo）单独用，主程序不读
# STUB_WEBSEARCH=1    → 跑周报/路由用例时打桩网搜，零 Tavily 消耗（tests/README.md 有说明）
# APP_URL=http://127.0.0.1:8123
# APP_PWD=
# CDP_PORT=9333
# OPENROUTER_API_KEY=
# STUB_WEBSEARCH=

# ============ 开关与参数（可选：也能在「⚙️ 设置」页里改，改完存库即生效） ============
# 不写也有默认值；写在这里相当于给一份"出厂预设"，设置页会显示「来自 .env」。
# ASR_ENABLED=1                  # 语音转文字总开关
# ZX_STREAM=1                    # 流式输出
# ZX_ASSEMBLY_SOURCES=new        # 上下文装配实现（new / legacy，改完需重启）
# TOOL_CALL_LOG_ENABLED=1        # 工具调用日志（data/audit/tool_calls.jsonl）
# AGENT_ERROR_LOG_ENABLED=1      # Agent 错误日志（data/audit/agent_errors.jsonl）
# DS_DEBUG_PROMPTS=0             # 提示词调试转储（写 data/audit/prompts_dump.txt）
# DECISION_CACHE_ENABLED=1       # 决策路由缓存
# DECISION_AUDIT_SEEN=1          # 记录「路由来过」痕迹
# DECISION_ALLOW_NONE=0          # 允许决策模型回答「都不选」
# DECISION_TRIGGER=near_tie      # near_tie / always / gray / off
# DECISION_TIE_THRESHOLD=0.0005  # 近分阈值
# DECISION_TOP_K=3               # 精排候选数（2~8）
# DECISION_TIMEOUT_S=20          # 单次超时（秒）
# DECISION_MAX_RETRIES=2         # 失败重试次数（0~4）
# DECISION_BUDGET_PER_DAY=500    # 每日额度（次，0=不限）
# DECISION_BUDGET_PER_SESSION=200 # 每会话额度（次，0=不限）
# DECISION_CACHE_TTL_H=24        # 缓存有效（小时，0=不过期）

# ---------------- 浏览器抓取工具（v4.0 大点 05）----------------
# browser-use 装在**独立环境** browser_venv/（与主 venv 隔离：它的依赖与主项目冲突，实测会卸 14 个包 + 换 pydantic）。
# 装法（项目根执行）：
#   uv venv browser_venv --python 3.11
#   uv pip install --python browser_venv/Scripts/python.exe browser-use
# 开关/步数/超时/页数/无头 都在设置页「🌐 浏览器抓取」组里，不放这里。
# 关掉匿名遥测（browser-use 默认会发 PostHog 匿名统计；工具侧也会显式设一次）：
ANONYMIZED_TELEMETRY=false
